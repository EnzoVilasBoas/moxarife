{
  "name": "moxarife/api",
  "description": "API do Moxarife",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "firebase/php-jwt": "^7.2",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Moxarife\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Moxarife\\Api\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testdox",
    "lint": "find src public bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
